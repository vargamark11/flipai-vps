[Unit]
Description=FlipAI Admin Auth
After=network.target

[Service]
Type=simple
User=debian
WorkingDirectory=/opt/flipai-vps
EnvironmentFile=/etc/flipai.env
ExecStart=/opt/flipai/.venv/bin/uvicorn admin.main:app --host 127.0.0.1 --port 3001
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
